<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.simbest.ai</groupId>
    <artifactId>simbest-plugin-parent</artifactId>
    <version>1.0.0</version>
  </parent>
  <groupId>com.simbest.ai</groupId>
  <artifactId>simbest-plugin-system</artifactId>
  <version>1.0.0</version>
  <name>simbest-plugin-system</name>
  <description>simbest-plugin-system</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-orm</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-log</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-trans</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-excel</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-file</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-datascope</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-tenant</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-config</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-idempotent</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-social</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-message</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>false</skipTests>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
