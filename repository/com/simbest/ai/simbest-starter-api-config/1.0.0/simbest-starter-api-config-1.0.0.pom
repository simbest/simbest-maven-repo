    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <dependencies>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-trans</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.simbest.ai</groupId>
      <artifactId>simbest-starter-orm</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
