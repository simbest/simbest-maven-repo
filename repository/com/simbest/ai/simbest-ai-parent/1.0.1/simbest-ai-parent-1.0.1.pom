        <groupId>com.simbest.ai</groupId>
        <artifactId>simbest-starter-excel</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>com.simbest.ai</groupId>
        <artifactId>simbest-starter-config</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>com.simbest.ai</groupId>
        <artifactId>simbest-starter-job</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>com.simbest.ai</groupId>
        <artifactId>simbest-starter-id</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>com.simbest.ai</groupId>
        <artifactId>simbest-starter-id-mybatis-plus</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>com.simbest.ai</groupId>
        <artifactId>simbest-starter-datascope</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>com.simbest.ai</groupId>
        <artifactId>simbest-starter-message</artifactId>
        <version>1.0.1</version>
      </dependency>
      <dependency>
        <groupId>com.simbest.ai</groupId>
        <artifactId>simbest-starter-crypto</artifactId>
