        <repository>
            <id>thirdparty</id>
            <url>http://10.87.57.26:8082/nexus/repository/maven-thirdparty/</url>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>releases</id>
            <url>http://10.87.57.26:8082/nexus/repository/releases/</url>
        </repository>
        <snapshotRepository>
            <id>snapshots</id>
