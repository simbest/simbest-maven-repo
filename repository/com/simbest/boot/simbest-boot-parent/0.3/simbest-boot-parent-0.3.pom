<?xml version="1.0"?>
<project
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
        xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.2.2.RELEASE</version>
    </parent>

    <groupId>com.simbest.boot</groupId>
    <artifactId>simbest-boot-parent</artifactId>
    <version>0.3</version>
    <packaging>pom</packaging>
    <name>${project.artifactId}</name>
    <description>Spring Boot Parent</description>

    <properties>
        <jdk.version>1.8</jdk.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.locales>zh_CN</project.build.locales>
        <spring.boot.version>2.2.2.RELEASE</spring.boot.version>
        <spring.cloud.version>Finchley.BUILD-SNAPSHOT</spring.cloud.version>
        <spring.admin.version>1.5.7</spring.admin.version>

        <maven-compiler-plugin.version>3.1</maven-compiler-plugin.version>
        <maven-resources-plugin.version>2.6</maven-resources-plugin.version>
        <maven-source-plugin.version>2.3</maven-source-plugin.version>
        <maven-javadoc-plugin.version>2.9.1</maven-javadoc-plugin.version>
        <maven-deploy-plugin.version>2.8.1</maven-deploy-plugin.version>
        <github-site-maven-plugin.version>0.11</github-site-maven-plugin.version>
        <github.global.server>github</github.global.server>

        <hutool.version>5.3.7</hutool.version>

        <!-- 漏洞 CVE-2021-44832 -->
        <log4j2.version>2.17.1</log4j2.version>
        <!-- 漏洞 CVE-2020-1938-->
        <tomcat.version>9.0.65</tomcat.version>

    </properties>

    <dependencies>
        <!-- NACOS START -->
        <!-- https://mvnrepository.com/artifact/com.alibaba.cloud/spring-cloud-starter-alibaba-nacos-config/2.2.2.RELEASE -->
        <dependency>
